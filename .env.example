# ─────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────
# EMAIL — Resend
# ─────────────────────────────────────────────
RESEND_API_KEY=re_your_key

# ─────────────────────────────────────────────
# PAYPAL
# ─────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET_KEY=your-paypal-secret-key
PAYPAL_MODE=sandbox

# ─────────────────────────────────────────────
# ADMIN EPG
# Contrasena para subir la programacion de Chiki Toonz.
# Genera con: openssl rand -hex 32
# ─────────────────────────────────────────────
ADMIN_EPG_PASSWORD=generate-with-openssl-rand-hex-32

# Secreto HMAC para firmar tokens de sesion del admin EPG.
# OBLIGATORIO y DISTINTO de ADMIN_EPG_PASSWORD.
# Genera con: openssl rand -hex 32
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32-different-value

# ─────────────────────────────────────────────
# VERCEL BLOB (almacenamiento del EPG)
# Obtener en: Vercel Dashboard > Storage > Blob > .env.local
# ─────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# ─────────────────────────────────────────────
# N8N WEBHOOKS
# URL del webhook que valida emails contra Odoo
# ─────────────────────────────────────────────
N8N_VALIDATE_EMAIL_WEBHOOK_URL=https://your-n8n-instance/webhook/validate-email
# URL del webhook que se llama al aprobar un pago manual
N8N_PAYMENT_CONFIRM_WEBHOOK_URL=https://your-n8n-instance/webhook/payment-confirm
# Secreto compartido enviado en el header x-webhook-secret
N8N_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# ─────────────────────────────────────────────
# RATE LIMITING — Upstash Redis (opcional pero recomendado)
# Tier gratuito disponible en https://upstash.com
# Sin estas variables el rate limit funciona solo por proceso (no distribuido).
# Pasos: crear cuenta > nueva base Redis > copiar REST URL y token.
# ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://mic.pe
